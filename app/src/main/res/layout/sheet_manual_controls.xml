<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_control_panel"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="🎛 PRO Ручные настройки"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnResetAuto"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="Сброс на Авто"
            android:textColor="@color/accent_yellow" />
    </RelativeLayout>

    <!-- ISO Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvIsoLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Чувствительность (ISO): Авто"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchAutoIso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Авто"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <com.google.android.material.slider.Slider
        android:id="@+id/sliderIso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:enabled="false"
        android:value="100"
        android:valueFrom="100"
        android:valueTo="3200"
        android:stepSize="100" />

    <!-- Shutter Speed Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvShutterLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Выдержка (Shutter): Авто"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchAutoShutter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Авто"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <com.google.android.material.slider.Slider
        android:id="@+id/sliderShutter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:enabled="false"
        android:value="100"
        android:valueFrom="30"
        android:valueTo="2000"
        android:stepSize="10" />

    <!-- Focus Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvFocusLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Фокус: Автофокус (Непрерывный)"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchAutoFocus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Авто"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <com.google.android.material.slider.Slider
        android:id="@+id/sliderFocus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:enabled="false"
        android:value="0"
        android:valueFrom="0"
        android:valueTo="10"
        android:stepSize="0.1" />

    <!-- White Balance Chips -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Баланс белого (WB)"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupWb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipWbAuto"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Авто WB" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipWbDaylight"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☀️ День" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipWbCloudy"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☁️ Облачно" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipWbIncandescent"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💡 Лампа накаливания" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipWbFluorescent"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔦 Флуоресцент" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

</LinearLayout>
