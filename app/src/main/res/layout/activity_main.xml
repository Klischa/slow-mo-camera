<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_dark"
    tools:context=".ui.MainActivity">

    <!-- Camera Preview TextureView with Auto-fit Aspect Ratio and Rotation Matrix -->
    <com.klischa.slowmocamera.ui.AutoFitTextureView
        android:id="@+id/textureView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Focus Ring View for Tap-To-Focus -->
    <com.klischa.slowmocamera.ui.FocusRingView
        android:id="@+id/focusRingView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Shutter Flash View (Brief white overlay on photo capture) -->
    <View
        android:id="@+id/viewShutterFlash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:visibility="gone" />

    <!-- Top Bar with Settings, PRO Manual Controls, Profile Pill, and Switcher -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#80000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Settings Button (Gear) -->
        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Настройки съёмки"
            android:src="@drawable/ic_settings" />

        <!-- PRO Manual Controls Button -->
        <Button
            android:id="@+id/btnProManual"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:paddingHorizontal="8dp"
            android:text="PRO"
            android:textColor="@color/accent_yellow"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Current Profile / Mode Pill -->
        <TextView
            android:id="@+id/tvCurrentProfileBadge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_badge"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp"
            android:text="HFR • 720p @ 240fps"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Camera Switcher -->
        <ImageButton
            android:id="@+id/btnSwitchCamera"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_switch_camera"
            android:src="@drawable/ic_camera_switch" />
    </LinearLayout>

    <!-- Zoom Indicator Badge (Shows on pinch zoom) -->
    <TextView
        android:id="@+id/tvZoomBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_badge"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:text="1.0x"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomPanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible" />

    <!-- Recording Indicator & Timer HUD -->
    <LinearLayout
        android:id="@+id/recordingHud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_badge"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        tools:visibility="visible">

        <View
            android:id="@+id/recDot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/ic_record_stop" />

        <TextView
            android:id="@+id/tvTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="00:00"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLiveFps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="240 FPS"
            android:textColor="@color/primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Clean Bottom Action Bar -->
    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_control_panel"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Mode Selector Switcher (ФОТО | SLOW-MO | ТАЙМЛАПС | БУФЕР) -->
        <HorizontalScrollView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:scrollbars="none">

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabCaptureMode"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                app:tabIndicatorColor="@color/primary"
                app:tabIndicatorHeight="3dp"
                app:tabMode="auto"
                app:tabPaddingEnd="12dp"
                app:tabPaddingStart="12dp"
                app:tabRippleColor="@null"
                app:tabSelectedTextColor="@color/primary"
                app:tabTextColor="@color/text_secondary">

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ФОТО" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SLOW-MO" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ТАЙМЛАПС" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="БУФЕР" />
            </com.google.android.material.tabs.TabLayout>
        </HorizontalScrollView>

        <!-- Shutter & Controls Row -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <!-- Gallery History Button (Left) -->
            <ImageButton
                android:id="@+id/btnOpenGallery"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_badge"
                android:contentDescription="История записей"
                android:padding="12dp"
                android:src="@drawable/ic_gallery"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Main Shutter Button (Center) -->
            <ImageButton
                android:id="@+id/btnRecord"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Спуск затвора"
                android:scaleType="centerInside"
                android:src="@drawable/ic_record_start"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Snapshot Photo Button during Video Recording -->
            <ImageButton
                android:id="@+id/btnSnapshotDuringRecord"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_badge"
                android:contentDescription="Снимок во время видео"
                android:padding="10dp"
                android:src="@drawable/ic_photo_camera"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/btnRecord"
                app:layout_constraintStart_toEndOf="@id/btnRecord"
                app:layout_constraintTop_toTopOf="@id/btnRecord"
                tools:visibility="visible" />

            <!-- Quick Play Last Media (Right) -->
            <ImageButton
                android:id="@+id/btnPlayLastVideo"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_badge"
                android:contentDescription="Смотреть последнее медиа"
                android:padding="12dp"
                android:src="@drawable/ic_play"
                android:visibility="invisible"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:visibility="visible" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
