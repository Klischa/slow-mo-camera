<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_control_panel"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="⚙️ Параметры съёмки"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCloseSettings"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="Готово"
            android:textColor="@color/primary" />
    </RelativeLayout>

    <!-- Section 1: Recording Mode -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Режим сохранения"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupModeSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipModeHfrSheet"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="HFR Slow-Mo (30fps)"
            android:textColor="@color/text_primary" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipModeHsrSheet"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HSR High-FPS"
            android:textColor="@color/text_primary" />
    </com.google.android.material.chip.ChipGroup>

    <TextView
        android:id="@+id/tvModeDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/mode_hfr_desc"
        android:textColor="@color/text_disabled"
        android:textSize="11sp" />

    <!-- Section 2: Profiles (Resolution & FPS) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Разрешение и частота кадров"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupProfilesSheet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true" />
    </HorizontalScrollView>

    <!-- Section 3: Codec -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Формат и кодек видео"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupCodecSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipCodecMp4Sheet"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="MP4 (H.264 / AVC)"
            android:textColor="@color/text_primary" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipCodecWebmSheet"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WebM (VP9)"
            android:textColor="@color/text_primary" />
    </com.google.android.material.chip.ChipGroup>

    <!-- Section 4: Stabilization Settings button -->
    <Button
        android:id="@+id/btnOpenStabilizationSettings"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="🎥 Стабилизация (OIS / EIS / Gyroflow)"
        android:textColor="@color/primary" />

    <!-- Section 5: Diagnostics button -->
    <Button
        android:id="@+id/btnOpenDiagnostics"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:drawableStart="@drawable/ic_info"
        android:text="Просмотреть отчёт HAL Диагностики"
        android:textColor="@color/text_primary" />

</LinearLayout>
